@page "/success/{SheetId:long}"
@using VisitorApp.Services.Kernel
@using QRCoder
@inject NavigationManager Nav
@inject VisitorRegistrationService RegService
@inject VisitorFormState State
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>登记成功 · 访客凭证</PageTitle>

<section class="va-step-page">
    <div class="va-stepper">
        <div class="va-step va-step-done"><span>1</span>隐私同意</div>
        <div class="va-step-bar va-step-bar-done"></div>
        <div class="va-step va-step-done"><span>2</span>信息填写</div>
        <div class="va-step-bar va-step-bar-done"></div>
        <div class="va-step va-step-active"><span>3</span>登记完成</div>
    </div>

    @if (_loading)
    {
        <div class="va-card va-loading">正在生成凭证…</div>
    }
    else if (_visitor is null)
    {
        <div class="va-card">
            <div class="va-empty">
                <span class="va-empty-icon">!</span>
                <h3>未找到登记记录</h3>
                <p>该访客凭证不存在或已过期。</p>
                <a class="va-btn va-btn-primary va-btn-lg" href="">返回首页</a>
            </div>
        </div>
    }
    else
    {
        <div class="va-success-wrap">
            <div class="va-success-banner">
                <div class="va-success-check">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="2" />
                        <path d="M7 12.5l3.2 3.2L17 8.8" stroke="currentColor" stroke-width="2.6"
                              stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    </svg>
                </div>
                <div>
                    <h2>登记成功，欢迎光临！</h2>
                    <p>请在前台领取访客证或出示下方凭证</p>
                </div>
                <div class="va-success-time">
                    <span>登记时间</span>
                    <strong>@_visitor.CheckInTime.ToString("HH:mm:ss")</strong>
                </div>
            </div>

            <div class="va-pass">
                <div class="va-pass-left">
                    <div class="va-pass-head">
                        <span class="va-pass-label">VISITOR PASS</span>
                        <span class="va-pass-date">@_visitor.CheckInTime.ToString("yyyy / MM / dd")</span>
                    </div>

                    <div class="va-pass-body">
                        <div class="va-pass-avatar">@Initial(_visitor.Name)</div>
                        <div class="va-pass-info">
                            <div class="va-pass-name">@_visitor.Name
                                @if (_visitor.Companions > 0)
                                {
                                    <span class="va-badge va-badge-info">同行 @_visitor.Companions 人</span>
                                }
                            </div>
                            <div class="va-pass-meta">@(string.IsNullOrWhiteSpace(_visitor.Company) ? "—" : _visitor.Company)</div>
                            <div class="va-pass-meta">访 <strong>@_visitor.HostName</strong>
                                @if (!string.IsNullOrWhiteSpace(_visitor.HostDepartment))
                                {
                                    <span>（@_visitor.HostDepartment）</span>
                                }
                            </div>
                            <div class="va-pass-purpose">事由：@_visitor.Purpose</div>
                        </div>
                    </div>

                    <div class="va-pass-foot">
                        <div>
                            <span>访客编号</span>
                            <strong class="va-code">@_visitor.VisitCode</strong>
                        </div>
                        <div>
                            <span>状态</span>
                            <strong class="@_visitor.Status.ToBadgeClass()">@_visitor.Status.ToDisplay()</strong>
                        </div>
                    </div>
                </div>

                <div class="va-pass-right">
                    @if (!string.IsNullOrEmpty(_visitor.FacePhoto))
                    {
                        <img class="va-pass-face" src="@_visitor.FacePhoto" alt="Face" />
                    }
                    <div class="va-qr">
                        @((MarkupString)_qrSvg)
                    </div>
                    <div class="va-qr-hint">
                        扫码可核验<br />
                        或向前台口播编号
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_visitor.IdNumber) || !string.IsNullOrWhiteSpace(_visitor.Address))
            {
                <div class="va-pass-extra">
                    @if (!string.IsNullOrWhiteSpace(_visitor.IdNumber))
                    {
                        <div><span>身份证号</span><strong>@MaskId(_visitor.IdNumber)</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_visitor.Gender))
                    {
                        <div><span>性别 / 出生</span><strong>@_visitor.Gender · @_visitor.Birthday</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_visitor.Address))
                    {
                        <div class="va-pass-extra-wide"><span>住址</span><strong>@MaskAddress(_visitor.Address)</strong></div>
                    }
                </div>
            }

            <div class="va-success-actions">
                <button class="va-btn va-btn-ghost va-btn-lg" @onclick="Print" disabled="@_printing">🖨 打印凭证</button>
                <button class="va-btn va-btn-primary va-btn-lg" @onclick="Done">完成，返回首页</button>
            </div>

            <p class="va-success-tip">
                ⏱ <strong>@_remain</strong> 秒后自动返回首页
            </p>
        </div>
    }
</section>

@code {
    [Parameter] public long SheetId { get; set; }

    private Visitor? _visitor;
    private bool _loading = true;
    private string _qrSvg = string.Empty;
    private System.Threading.Timer? _redirectTimer;
    private int _remain = 30;

    protected override async Task OnInitializedAsync()
    {
        // 优先用当前会话的内存态（刚提交完跳转过来），否则按登记单号从后端回查。
        if (State.LastSubmitted is not null && State.LastSubmitted.SheetId == SheetId)
        {
            _visitor = State.LastSubmitted;
        }
        else
        {
            try
            {
                var sheet = await RegService.GetSheetAsync(SheetId);
                _visitor = sheet is null ? null : VisitorRegistrationService.ToVisitor(sheet);
            }
            catch
            {
                _visitor = null;   // 后端不可达时展示"未找到"，不阻断页面
            }
        }
        _loading = false;

        if (_visitor is not null)
        {
            _qrSvg = BuildQrSvg($"VC:{_visitor.VisitCode}|{_visitor.Name}|{_visitor.Phone}");
        }

        _redirectTimer = new System.Threading.Timer(_ =>
        {
            _remain--;
            if (_remain <= 0)
            {
                _redirectTimer?.Dispose();
                InvokeAsync(Done);
            }
            else
            {
                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private void Done()
    {
        State.ResetAll();
        Nav.NavigateTo("");
    }

    private bool _printing;

    /// <summary>打印凭证：BlazorWebView 内通过 JS interop 调用 window.print()，失败时给出反馈而不中断。</summary>
    private async Task Print()
    {
        if (_printing) return;
        _printing = true;
        try
        {
            await JS.InvokeVoidAsync("eval", "window.print()");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Success] 打印调用失败：{ex.Message}");
        }
        finally
        {
            _printing = false;
        }
    }

    private static string Initial(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "·";
        return name.Trim()[0].ToString();
    }

    /// <summary>身份证号脱敏：保留前 4 后 4，中间 *。</summary>
    private static string MaskId(string id)
    {
        if (string.IsNullOrWhiteSpace(id) || id.Length < 9) return id ?? string.Empty;
        return string.Concat(id.AsSpan(0, 4), new string('*', id.Length - 8), id.AsSpan(id.Length - 4, 4));
    }

    /// <summary>住址脱敏：保留省市区前缀与末尾 2 字，中间以 * 代替（凭证可能被他人看到）。</summary>
    private static string MaskAddress(string addr)
    {
        if (string.IsNullOrWhiteSpace(addr)) return addr ?? string.Empty;
        if (addr.Length <= 12) return addr;
        return string.Concat(addr.AsSpan(0, 9), "****", addr.AsSpan(addr.Length - 2, 2));
    }

    /// <summary>
    /// 用 QRCoder 生成真实可扫描的二维码（SVG 渲染，无需位图资源），
    /// 四周留 4 模块静区提升扫码识别率；生成失败返回空串，不阻断成功页展示。
    /// </summary>
    private static string BuildQrSvg(string payload)
    {
        try
        {
            using var generator = new QRCodeGenerator();
            using var data = generator.CreateQrCode(payload, QRCodeGenerator.ECCLevel.M);
            var matrix = data.ModuleMatrix;
            var count = matrix.Count;
            const int quiet = 4;
            const int cell = 8;
            var total = count + quiet * 2;
            var px = total * cell;

            var sb = new System.Text.StringBuilder();
            sb.Append($"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 {px} {px}' width='100%' height='100%' shape-rendering='crispEdges'>");
            sb.Append($"<rect width='{px}' height='{px}' fill='#ffffff'/>");
            for (var r = 0; r < count; r++)
            {
                for (var c = 0; c < count; c++)
                {
                    if (!matrix[r][c]) continue;
                    sb.Append($"<rect x='{(c + quiet) * cell}' y='{(r + quiet) * cell}' width='{cell}' height='{cell}' fill='#0f172a'/>");
                }
            }
            sb.Append("</svg>");
            return sb.ToString();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Success] 二维码生成失败：{ex.Message}");
            return string.Empty;
        }
    }

    public void Dispose() => _redirectTimer?.Dispose();
}
