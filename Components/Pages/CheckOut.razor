@page "/checkout"
@using VisitorApp.Services.Kernel
@inject VisitorRegistrationService RegService
@inject NavigationManager Nav

<PageTitle>离场签退 · 访客自助</PageTitle>

<section class="va-step-page">
    <div class="va-card va-search-card">
        <h2>离场签退</h2>
        <p class="va-muted">请输入登记时使用的手机号，或登记单号。</p>

        <div class="va-search-row">
            <input class="va-input va-input-lg va-grow" @bind="_keyword"
                   @bind:event="oninput" @onkeydown="OnKey"
                   placeholder="手机号 / 登记单号" autofocus />
            <button class="va-btn va-btn-primary va-btn-lg" @onclick="SearchAsync" disabled="@_loading">
                @if (_loading) { <span>查询中…</span> } else { <span>🔍 查询</span> }
            </button>
        </div>

        @if (_searched && _list.Count == 0 && _byCode is null)
        {
            <div class="va-empty">
                <span class="va-empty-icon">∅</span>
                <h3>未找到匹配的在场记录</h3>
                <p>请确认手机号 / 登记单号是否正确，或前往前台协助处理。</p>
            </div>
        }
        else if (_byCode is not null)
        {
            <VisitorRow Visitor="_byCode" OnCheckOut="@(v => CheckOutAsync(v))" />
        }
        else if (_list.Count > 0)
        {
            <h3 class="va-card-title">查询到 @_list.Count 条在场记录</h3>
            @foreach (var v in _list)
            {
                <VisitorRow Visitor="v" OnCheckOut="@(x => CheckOutAsync(x))" />
            }
        }
    </div>
</section>

<Toast @ref="_toast" />

@code {
    private string _keyword = string.Empty;
    private List<Visitor> _list = new();
    private Visitor? _byCode;
    private bool _searched;
    private bool _loading;
    private Toast? _toast;

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        var key = _keyword?.Trim() ?? string.Empty;
        if (string.IsNullOrEmpty(key))
        {
            await (_toast?.ShowAsync("请输入手机号或登记单号", "error") ?? Task.CompletedTask);
            return;
        }

        _loading = true;
        _searched = false;
        _list = new List<Visitor>();
        _byCode = null;

        try
        {
            // 纯数字按登记单号（后端 SheetID）精确查询
            if (long.TryParse(key, out var sheetId))
            {
                var sheet = await RegService.GetSheetAsync(sheetId);
                if (sheet is not null && sheet.State == 4)
                {
                    _byCode = VisitorRegistrationService.ToVisitor(sheet);
                }
                else if (sheet is not null)
                {
                    await (_toast?.ShowAsync($"登记单 {sheetId} 已于 {sheet.CheckOutTime:HH:mm} 签退", "error") ?? Task.CompletedTask);
                }
            }
            else
            {
                // 手机号：查今天起 30 天内的在场单，主访客或随行人员手机号匹配均可
                var sheets = await RegService.GetOnSiteSheetsAsync(30);
                _list = sheets
                    .Where(s => s.VisitorMobile == key
                                || (s.Visitors?.Any(v => v.Mobile == key) ?? false))
                    .Select(VisitorRegistrationService.ToVisitor)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            await (_toast?.ShowAsync($"查询失败：{ex.Message}", "error") ?? Task.CompletedTask);
        }
        finally
        {
            _loading = false;
            _searched = true;
        }
    }

    private async Task CheckOutAsync(Visitor v)
    {
        if (v.SheetId <= 0)
        {
            await (_toast?.ShowAsync("缺少登记单号，无法签退，请联系前台", "error") ?? Task.CompletedTask);
            return;
        }

        _loading = true;
        try
        {
            var reply = await RegService.CheckOutAsync(v.SheetId);
            if (reply.IsSuccess)
            {
                await (_toast?.ShowAsync($"{v.Name}，再见！已成功签退") ?? Task.CompletedTask);
                await Task.Delay(800);
                Nav.NavigateTo("");
            }
            else
            {
                await (_toast?.ShowAsync($"签退失败：{reply.msg ?? "请重试"}", "error") ?? Task.CompletedTask);
            }
        }
        catch (Exception ex)
        {
            await (_toast?.ShowAsync($"签退失败：{ex.Message}", "error") ?? Task.CompletedTask);
        }
        finally
        {
            _loading = false;
        }
    }
}
