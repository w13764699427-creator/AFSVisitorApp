@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject LocalizationService L
@inject VisitorFormState FormState

<div class="va-shell">
    <header class="va-top">
        <a class="va-brand" href="" @onclick:preventDefault @onclick="BackHome">
            <span class="va-logo">访</span>
            <div class="va-brand-text">
                <strong>智能访客自助登记</strong>
                <span>@L["app.subtitle"]</span>
            </div>
        </a>
        <div class="va-top-right">
            <Clock />
            <LanguageSwitcher />
            @if (!IsSettings)
            {
                <a class="va-btn va-btn-ghost" href="settings" title="系统设置">⚙</a>
            }
            @if (!IsHome)
            {
                <a class="va-btn va-btn-ghost" href="" @onclick:preventDefault @onclick="BackHome">@L["app.back_home"]</a>
            }
        </div>
    </header>

    <main class="va-main">
        @Body
    </main>

    <footer class="va-foot">
        <span>@L["app.footer.contact"]</span>
        <span>@L["app.footer.version"]</span>
    </footer>
</div>

<AntContainer />

@code {
    private bool IsHome
    {
        get
        {
            var uri = new Uri(Nav.Uri);
            return string.IsNullOrEmpty(uri.AbsolutePath.Trim('/'));
        }
    }

    private bool IsSettings
    {
        get
        {
            var uri = new Uri(Nav.Uri);
            return uri.AbsolutePath.Trim('/').Equals("settings", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        L.OnLanguageChanged += OnLangChanged;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        L.OnLanguageChanged -= OnLangChanged;
    }

    /// <summary>返回首页：同时清空登记流程状态，避免上一位访客半途离开后残留信息被下一位看到。</summary>
    private void BackHome()
    {
        FormState.ResetAll();
        Nav.NavigateTo("");
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void OnLangChanged() => InvokeAsync(StateHasChanged);
}
